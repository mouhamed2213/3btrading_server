new file mode 100644
index 0000000..01fa3fe
--- /dev/null
+++ b/src/middlewares/request-logger.ts
@@ -0,0 +1,33 @@
+import { randomUUID } from "node:crypto";
+import type { RequestHandler } from "express";
+import { getLogger, requestContext, type RequestContext } from "../lib/logger.js";
+
+const log = getLogger("http");
+/** Appels de supervision : on ne les log qu'en cas de problème. */
+const QUIET_PATHS = new Set(["/health"]);
+
+/** Premier middleware : identifiant de requête (renvoyé dans l'en-tête X-Request-Id) et une ligne de log par requête terminée. */
+export const requestLogger: RequestHandler = (req, res, next) => {
+  const incoming = req.get("x-request-id");
+  const ctx: RequestContext = { requestId: incoming && /^[\w-]{6,64}$/.test(incoming) ? incoming : randomUUID().slice(0, 8) };
+  res.locals.ctx = ctx;
+  res.setHeader("X-Request-Id", ctx.requestId);
+  const started = process.hrtime.bigint();
+
+  res.on("finish", () => {
+    const ms = Math.round(Number(process.hrtime.bigint() - started) / 1e6);
+    const status = res.statusCode;
+    const path = req.originalUrl.split("?")[0];
+    const reason = res.locals.reason as string | undefined; // renseigné par le gestionnaire d'erreurs
+    const level = status >= 500 ? "error" : status >= 400 ? "warn" : QUIET_PATHS.has(path ?? "") ? "debug" : "info";
+    log.log(level, `${req.method} ${path} ${status} ${ms}ms${reason ? ` — ${reason}` : ""}`, {
+      ...(status >= 400 && { ip: req.ip }), // l'adresse IP n'est utile qu'en cas de problème
+      user: ctx.user,
+      requestId: ctx.requestId,
+    });
+  });
+  next();
+};
+
+/** À placer APRÈS le parsing du corps : les logs émis pendant le traitement héritent de l'identifiant de requête et de l'utilisateur. */
+export const bindRequestContext: RequestHandler = (_req, res, next) => requestContext.run(res.locals.ctx as RequestContext, next);
