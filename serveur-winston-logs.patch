+// ── Étapes de formatage communes ──────────────────────────────────────────────
+
+/** `logger.error("message", { err })` : déplie l'erreur (message + pile) au lieu d'afficher « {} ». */
+const unfoldError = winston.format((info) => {
+  const e = info.err;
+  if (e instanceof Error) {
+    info.error = e.message;
+    info.stack = e.stack;
+    const code = (e as { code?: unknown }).code;
+    if (code !== undefined) info.code = code;
+    delete info.err;
+  }
+  return info;
+});
+
+/** Ajoute l'identifiant de requête et l'utilisateur courant. */
+const addContext = winston.format((info) => {
+  const ctx = requestContext.getStore();
+  if (ctx) {
+    info.requestId ??= ctx.requestId;
+    if (ctx.user) info.user ??= ctx.user;
+  }
+  return info;
+});
+
+/** Domaine par défaut. (Pas de `defaultMeta` winston : il écraserait le domaine des sous-loggers `getLogger("…")`.) */
+const defaultScope = winston.format((info) => {
+  info.scope ??= "app";
+  return info;
+});
+
+/** Masque tout champ sensible (mot de passe, jeton, en-tête Authorization…) qui aurait été passé en métadonnée. */
+const maskSecrets = winston.format((info) => {
+  for (const key of Object.keys(info)) if (SENSITIVE.test(key)) info[key] = "[masqué]";
+  return info;
 });
+
+// ── Format lisible (développement) ────────────────────────────────────────────
+//   14:32:05.123 INFO  http     GET /api/invoices 200 12ms  user=admin@3btrading.sn req=a1b2c3d4
+
+const dim = (s: string) => `\x1b[90m${s}\x1b[39m`;
