+  })(),
+  winston.format.colorize({ level: true }),
+  winston.format.printf(({ timestamp, level, scope, message, stack, ...meta }) => {
+    const tags = Object.entries(meta)
+      .filter(([k, v]) => v !== undefined && v !== null && !(k === "error" && stack)) // le message est déjà la 1re ligne de la pile
+      .sort(([a], [b]) => TAIL.indexOf(a) - TAIL.indexOf(b)) // tri stable : les clés hors TAIL (-1) restent en tête, dans l'ordre d'émission
+      .map(([k, v]) => `${SHORT[k] ?? k}=${show(v)}`)
+      .join(" ");
+    return `${timestamp} ${level} ${String(scope ?? "app").padEnd(12)} ${message}${tags ? `  ${dim(tags)}` : ""}${stack ? `\n${dim(String(stack))}` : ""}`;
+  }),
+);
+
+// ── Format structuré (production) : une ligne JSON par événement, exploitable par n'importe quel agrégateur de logs ──
+
+const json = winston.format.combine(winston.format.timestamp(), unfoldError(), addContext(), defaultScope(), maskSecrets(), winston.format.json());
+
+export const logger = winston.createLogger({
+  level,
+  silent: env.NODE_ENV === "test",
+  format: isProd ? json : pretty,
+  transports: [new winston.transports.Console()],
+});
+
+/** Logger d'un domaine précis : `const log = getLogger("factures")` → les lignes affichent `factures`. */
+export const getLogger = (scope: string) => logger.child({ scope });
