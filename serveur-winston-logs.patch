+const SHORT: Record<string, string> = { requestId: "req" };
+/** Ordre d'affichage : les données propres à l'événement d'abord, puis qui (user), d'où (ip), et l'identifiant de requête. */
+const TAIL = ["user", "ip", "requestId"];
