NODE_ENV=development
PORT=4000

# PostgreSQL (Supabase Postgres, Neon, Railway… ou local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/3btrading_db

# Auth
JWT_SECRET=change-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# URL(s) du frontend autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# Supabase Storage (photos). Clé SERVICE ROLE : à garder côté serveur uniquement.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=3b-trading

# TVA appliquée par défaut aux factures (%)
TAX_RATE=18

# Compte administrateur créé par `npm run db:seed`
SEED_ADMIN_EMAIL=admin@3btrading.sn
SEED_ADMIN_PASSWORD=ChangeMe123!
