+ * Contexte de la requête HTTP en cours. Tant qu'une requête est traitée, chaque ligne de log
+ * (même émise depuis un service) porte automatiquement son identifiant `requestId` et l'utilisateur connecté.
+ */
+export type RequestContext = { requestId: string; user?: string };
+export const requestContext = new AsyncLocalStorage<RequestContext>();
